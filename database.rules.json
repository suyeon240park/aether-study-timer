{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['studySessions', 'dailyGoal', 'aethers', 'totalStudyTime'])",

        "studySessions": {
          "$date": {
            "$sessionId": {
              ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('timestamp').exists() && newData.child('minutes').exists()",
              "timestamp": { ".validate": "newData.isString()" },
              "minutes": { ".validate": "newData.isNumber() && newData.val() > 0" }
            }
          }
        },
        "dailyGoal": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "aethers": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "totalStudyTime": {
          "$date": {
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    ".read": "auth != null",
    ".write": "auth != null"
  }
}
