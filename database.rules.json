{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "dailyGoal": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "totalStudyTime": {
          "$date": {
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    }
  }
}